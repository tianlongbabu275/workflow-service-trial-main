    },
    {
      "displayName": "Notification Channels",
      "name": "notificationChannels",
      "description": "Task message will be sent via these notification channels",
      "type": "multiOptions",
      "options": [
        {
            "name": "HTTP",
            "value": "HTTP"
        }
      ]
    },
    {
      "displayName": "HTTP notification endpoint",
      "name": "httpNotificationEndpoint",
      "type": "string",
      "displayOptions": {
        "show": {
          "notificationChannels": ["HTTP"]
        }
      }
